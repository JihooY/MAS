MAS_HOST=127.0.0.1
MAS_PORT=8000
# Reverse-proxy domain(s), comma-separated. localhost is always allowed.
MAS_ALLOWED_HOSTS=

# Gmail address and MAS-specific password (12-256 characters). Optional bootstrap admin.
# Existing unowned projects are assigned to this admin on startup.
MAS_ADMIN_EMAIL=
MAS_ADMIN_PASSWORD=
# Set true behind an HTTPS reverse proxy; cookies then require HTTPS.
MAS_SESSION_HTTPS_ONLY=false
MAS_SESSION_MAX_HOURS=12

# All paths are relative to the repository unless absolute.
MAS_STORAGE_DIR=storage
MAS_MAX_UPLOAD_MB=150
MAS_MAX_DURATION_SECONDS=300
MAS_SEPARATION_MODEL=htdemucs
# auto selects CUDA when available, otherwise CPU. htdemucs_6s is experimental.
MAS_SEPARATION_DEVICE=auto

# A configured database failing to connect is reported, never silently replaced.
# With no URI, the local preview uses JSON project files (shown explicitly in UI).
MAS_MONGO_URI=
MAS_MONGO_DATABASE=music_analysis_studio

# Existing ~/.ssh/config Host alias. Uses OpenSSH and existing trusted host keys.
MAS_SSH_ALIAS=
MAS_SSH_REMOTE_HOST=127.0.0.1
MAS_SSH_REMOTE_PORT=27017
MAS_SSH_LOCAL_PORT=27018
# Example URI (percent-encode special characters in credentials):
# MAS_MONGO_URI=mongodb://USER:PASSWORD@127.0.0.1:27018/?authSource=admin&directConnection=true

# Music Flamingo listens separately to Full Mix, Vocal, Instrumental and whole-song context (WAV).
# Accepts a base URL (https://HOST/v1) or the full /v1/chat/completions URL.
# Example local endpoint: http://127.0.0.1:8001/v1/chat/completions
AUDIO_AI_URL=
AUDIO_AI_MODEL=nvidia/music-flamingo-hf
AUDIO_AI_API_KEY=

# gpt-oss interprets each type, then integrates comparisons, improvement advice and scores /10.
# Independent endpoint and key. Do not use MAS's own port (default 8000) as the LLM server.
LLM_AI_URL=
LLM_AI_MODEL=openai/gpt-oss-120b
LLM_AI_API_KEY=

# Each selected range is covered by <=30s WAV chunks; no silent audio truncation.
MAS_AI_TIMEOUT_SECONDS=300
MAS_AUDIO_CLIP_SECONDS=30
MAS_AUDIO_MAX_TOKENS=1024
MAS_LLM_MAX_TOKENS=8192
